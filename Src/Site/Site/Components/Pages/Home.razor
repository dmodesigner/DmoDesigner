<section class="hero-section py-5 d-flex align-items-center" style="min-height: 85vh;">
    <div class="container text-center">
                <span class="badge rounded-pill mb-4 px-3 py-2 fw-semibold"
                      style="background-color: rgba(0, 191, 255, 0.1); color: var(--primary-color); border: 1px solid rgba(0,191,255,0.2);">
