
@page "/"

<HeadContent>
    <title>DevPro | Desenvolvedor Full-Stack e Web Designer Sênior</title>
    <meta name="description"
          content="Especialista em desenvolvimento de sites, sistemas e-commerce e aplicativos móveis. Mais de 15 anos de experiência entregando excelência digital."/>
    <meta property="og:title" content="DevPro | Soluções Digitais de Alto Nível"/>
