@page "/contato"
<HeadContent>
    <title>Fale Comigo | Inicie Seu Projeto - DevPro</title>
</HeadContent>

<section class="contact-section py-5 mb-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <h6 class="text-primary-custom fw-bold text-uppercase tracking-wide mb-2">Vamos Conversar</h6>
                <h2 class="display-6 fw-bold mb-4">Pronto para o próximo nível?</h2>
                <p class="text-muted mb-5">
                    Preencha o formulário ou entre em contato diretamente. Responderei em até 24 horas úteis com uma
                    análise inicial da sua necessidade.
                </p>

                <div class="d-flex align-items-center mb-4">
                    <div class="bg-light p-3 rounded-circle me-3 text-primary-custom fw-bold">@</div>
                    <div>
                        <h6 class="fw-bold mb-0">E-mail</h6>
                        <p class="text-muted small mb-0">contato@seusite.com.br</p>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <div class="bg-light p-3 rounded-circle me-3 text-primary-custom fw-bold">📱</div>
                    <div>
                        <h6 class="fw-bold mb-0">WhatsApp</h6>
                        <p class="text-muted small mb-0">+55 (11) 99999-9999</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
                    <!-- No Blazor, use o componente <EditForm> -->
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="nome" class="form-label fw-semibold">Nome Completo</label>
                                <input type="text" class="form-control form-control-lg bg-light border-0" id="nome"
                                       placeholder="Seu nome">
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label fw-semibold">E-mail</label>
                                <input type="email" class="form-control form-control-lg bg-light border-0" id="email"
                                       placeholder="seu@email.com">
                            </div>
                            <div class="col-12">
                                <label for="assunto" class="form-label fw-semibold">Qual serviço você precisa?</label>
                                <select class="form-select form-select-lg bg-light border-0" id="assunto">
                                    <option selected>Selecione uma opção...</option>
                                    <option value="1">Desenvolvimento de Site</option>
                                    <option value="2">E-commerce</option>
                                    <option value="3">Aplicativo Mobile</option>
                                    <option value="4">Outros</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label for="mensagem" class="form-label fw-semibold">Mensagem / Detalhes do
                                    Projeto</label>
                                <textarea class="form-control form-control-lg bg-light border-0" id="mensagem" rows="4"
                                          placeholder="Descreva brevemente o que você tem em mente..."></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-glow w-100 border-0 py-3 fs-5">Enviar Mensagem
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>