
@page "/portfolio"
<HeadContent>
    <title>Portfólio | Projetos de Alta Performance - DevPro</title>
    <meta name="description"
          content="Explore o portfólio de projetos desenvolvidos. E-commerces, aplicativos e sistemas web escaláveis."/>
</HeadContent>

<section class="portfolio-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-primary-custom fw-bold text-uppercase tracking-wide mb-2">Trabalhos Recentes</h6>
            <h2 class="display-5 fw-bold">Meu Portfólio</h2>
            <p class="text-muted mx-auto mt-3" style="max-width: 600px;">Uma seleção de projetos de alto impacto focados
                em conversão, usabilidade e arquitetura robusta.</p>
        </div>

        <div class="row g-4">
            <!-- Projeto 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="bg-dark d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span class="fs-1">🛍️</span>
                    </div>
                    <div class="card-body p-4">
                        <span class="badge bg-light text-primary-custom mb-2">E-commerce</span>
                        <h5 class="fw-bold">Plataforma Varejo B2B</h5>
                        <p class="text-muted small">Sistema completo de vendas com integração ERP e gateway de pagamento
                            customizado via Blazor.</p>
                    </div>
                </div>
            </div>
            <!-- Projeto 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span class="fs-1">📱</span>
                    </div>
                    <div class="card-body p-4">
                        <span class="badge bg-light text-primary-custom mb-2">App Mobile</span>
                        <h5 class="fw-bold">Fintech App</h5>
                        <p class="text-muted small">Aplicativo financeiro multiplataforma com autenticação biométrica e
                            dashboards em tempo real.</p>
                    </div>
                </div>
            </div>
            <!-- Projeto 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="bg-dark d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span class="fs-1">🏢</span>
                    </div>
                    <div class="card-body p-4">
                        <span class="badge bg-light text-primary-custom mb-2">Web Design / SEO</span>
                        <h5 class="fw-bold">Portal Corporativo</h5>
                        <p class="text-muted small">Redesign completo com foco em Core Web Vitals, aumentando o tráfego
                            orgânico em 150%.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>